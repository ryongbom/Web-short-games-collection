<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>할 일 목록</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            max-width: 600px;
            margin: 50px auto;
            padding: 20px;
            background-color: #f5f5f5;
        }
        h1 { color: #333; }
        .todo-item {
            background: white;
            padding: 15px;
            margin: 10px 0;
            border-radius: 5px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            display: flex;
            align-items: center;
        }
        .todo-title {
            flex: 1;
            margin-left: 10px;
        }
        .done {
            text-decoration: line-through;
            color: #999;
        }
        .actions a {
            margin-left: 10px;
            text-decoration: none;
            color: #666;
        }
        .add-form {
            margin: 20px 0;
            padding: 20px;
            background: white;
            border-radius: 5px;
        }
        input[type="text"] {
            width: 70%;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 3px;
        }
        button {
            padding: 10px 20px;
            background: #0066cc;
            color: white;
            border: none;
            border-radius: 3px;
            cursor: pointer;
        }
        .stats {
            text-align: right;
            color: #666;
            margin: 10px 0;
        }
    </style>
</head>
<body>
    <h1>📝 나의 할 일 목록</h1>
    
    <!-- 할 일 추가 폼 -->
    <div class="add-form">
        <form action="/todos" method="POST">
            <input type="text" name="title" placeholder="할 일을 입력하세요" required>
            <button type="submit">추가</button>
        </form>
    </div>
    
    <!-- 통계 -->
    <div class="stats">
        전체: <%= todos.length %>개 | 
        완료: <%= todos.filter(t => t.done).length %>개 |
        미완료: <%= todos.filter(t => !t.done).length %>개
    </div>
    
    <!-- 할 일 목록 -->
    <% todos.forEach(todo => { %>
        <div class="todo-item">
            <form action="/todos/<%= todo.id %>/toggle" method="POST" style="display: inline;">
                <input type="checkbox" 
                       <%= todo.done ? 'checked' : '' %> 
                       onchange="this.form.submit()">
            </form>
            
            <span class="todo-title <%= todo.done ? 'done' : '' %>">
                <%= todo.title %>
            </span>
            
            <div class="actions">
                <a href="/todos/<%= todo.id %>/edit">✏️</a>
                <a href="/todos/<%= todo.id %>/delete" 
                   onclick="return confirm('삭제하시겠습니까?')">🗑️</a>
            </div>
        </div>
    <% }) %>
    
    <!-- 할 일이 없을 때 -->
    <% if (todos.length === 0) { %>
        <p style="text-align: center; color: #999;">할 일이 없습니다. 추가해보세요!</p>
    <% } %>
</body>
</html>