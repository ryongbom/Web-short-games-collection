<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>Todo List</title>
    <style>
        body {
            font-family: Arial;
            max-width: 600px;
            margin: 50px auto;
            background: #f5f5f5;
        }
        .todo-item {
            background: white;
            padding: 15px;
            margin: 10px 0;
            border-radius: 5px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            display: flex;
            align-items: center;
        }
        .done {
            text-decoration: line-through;
            color: #999;
        }
        .add-form {
            background: white;
            padding: 20px;
            border-radius: 5px;
            margin-bottom: 20px;
        }
        input[type="text"] {
            width: 80%;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 3px;
        }
        button {
            padding: 10px 20px;
            background: #007bff;
            color: white;
            border: none;
            border-radius: 3px;
            cursor: pointer;
        }
    </style>
</head>
<body>
    <h1>📝 Todo List</h1>

    <div class="add-form">
        <form action="/todos" method="POST">
            <input type="text" name="title" placeholder="할일을 입력하십시오" required>
            <button type="submit">추가</button>
        </form>
    </div>

    <% todos.forEach(todo => { %>
        <div class="todo-item">
            <form action="/todos/<%= todo._id %>/toggle" method="POST" style="margin: 0;">
                <input type="checkbox"
                    <%= todo.done ? 'checked' : '' %>
                    onchange="this.form.submit()">
            </form>

            <span style="flex: 1; margin: 10px;" class="<%= todo.done ? 'done' : '' %>">
                <%= todo.title %>
            </span>

            <a href="/todos/<%= todo._id %>/delete"
                style="color: #dc3545; text-decoration: none;"
                onclick="return confirm('삭제하시겠습니까?')">🗑️</a>
        </div>
    <% }) %>

    <% if (todos.length === 0) { %>
        <p style="text-align: center; color: #999;">할일이 없습니다. 추가하십시오!</p>
    <% } %>
</body>
</html>